{
  "name": "akcit-integration-testing-genai",
  "version": "1.0.0",
  "description": "Testes de integração Checkout ↔ Gateway de Pagamento gerados com apoio de GenAI",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:report": "node scripts/run-tests.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nock": "^13.5.6",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.js"
    ],
    "verbose": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "engines": {
    "node": ">=22.5"
  }
}
